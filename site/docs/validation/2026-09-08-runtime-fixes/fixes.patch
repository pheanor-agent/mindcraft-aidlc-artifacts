+test('TUI approval list remains responsive while the command queue is busy', { timeout: 2000 }, async () => {
+  const ui = fixture();
+  ui.app.listPendingApprovals = () => [{ id: 'approval-test', request: { kind: 'command.execute', command: 'node' }, status: 'pending' }];
