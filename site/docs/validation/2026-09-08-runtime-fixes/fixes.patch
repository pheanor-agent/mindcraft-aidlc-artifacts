diff --git a/test/windows-runtime-flow.test.mjs b/test/windows-runtime-flow.test.mjs
new file mode 100644
index 0000000..21ea5e3
--- /dev/null
+++ b/test/windows-runtime-flow.test.mjs
@@ -0,0 +1,46 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { mkdtemp, mkdir, writeFile, readFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join, resolve } from 'node:path';
+
+for (const commandCode of [0, 7]) test(`offline CLI setup, approval and persisted command result (${commandCode})`, {timeout:45000}, async () => {
+  const cwd = await mkdtemp(join(tmpdir(), 'mindcraft-runtime-'));
+  await mkdir(join(cwd,'test'));
+  await writeFile(join(cwd,'test/release-check.test.mjs'), `process.exit(${commandCode});`);
+  const env = Object.fromEntries(Object.entries(process.env).filter(([key]) => !/KEY|TOKEN|SECRET|MINDCRAFT|AIROUTER/i.test(key) && key.toLowerCase() !== 'path'));
+  env.PATH = process.platform === 'win32' ? join(process.env.SystemRoot,'System32') : '/nonexistent';
+  const executable = process.env.MINDCRAFT_TEST_EXE ?? process.execPath;
+  const args = [...(process.env.MINDCRAFT_TEST_EXE ? [] : [resolve('src/cli.mjs')]),'--cli','--mock','--workspace',cwd];
+  const child = spawn(executable,args,{cwd,env,windowsHide:true});
+  let output='';let exitCode=null;
+  child.stdout.on('data',d=>output+=d);child.stderr.on('data',d=>output+=d);
+  const exited=new Promise(r=>child.on('exit',c=>{exitCode=c;r(c);}));
+  async function wait(pattern) {const end=Date.now()+15000;while(!pattern.test(output)){assert.equal(exitCode,null,output);assert.ok(Date.now()<end,output);await new Promise(r=>setTimeout(r,25));}return output;}
+  function send(command){output='';child.stdin.write(command+'\n');}
+  try {
+    await wait(/mindcraft>/);send('setup mock deterministic');await wait(/setup=complete/);
+    send('model');await wait(/mock\/deterministic/);
+    send('task runtime validation');await wait(/task=/);
+    send('run inspect');await wait(/approval=([^\s]+)/);
+    const first=output.match(/approval=([^\s]+)/)[1];
+    send('approvals');await wait(new RegExp(first));assert.match(output,/filesystem.write/);
+    send('reject '+first);await wait(/approval=([^\s]+)/);
+    const second=output.match(/approval=([^\s]+)/)[1];
+    send('approvals');await wait(new RegExp(second));assert.match(output,/command.execute/);
+    send('approve '+second);
+    await wait(commandCode===0?/run=completed/:/COMMAND_EXECUTION_FAILED/);
+    assert.doesNotMatch(output,/ENOENT|event=undefined/);
+    send('quit');assert.equal(await exited,0);
+    const records=(await readFile(join(cwd,'.mindcraft/state.jsonl'),'utf8')).trim().split('\n').map(line=>JSON.parse(line).record);
+    const run=records.filter(r=>r.kind==='run').at(-1);
+    assert.equal(run.status,commandCode===0?'completed':'failed');
+    assert.equal(run.routing.selectedModelId,'mock-deterministic');
+    assert.equal(records.findLast(r=>r.type==='tool_execution_result').result.result.code,commandCode===0?0:1);
+    if(commandCode!==0) assert.equal(run.toolFailures.length,1);
+  } finally {
+    if(exitCode===null){child.stdin.write('quit\n');await Promise.race([exited,new Promise(r=>setTimeout(r,2000))]);if(exitCode===null)child.kill();}
+    await rm(cwd,{recursive:true,force:true});
+  }
+});
