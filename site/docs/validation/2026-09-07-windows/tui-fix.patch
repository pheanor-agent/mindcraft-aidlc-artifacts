diff --git a/test/tui-native-regressions.test.mjs b/test/tui-native-regressions.test.mjs
new file mode 100644
index 0000000..c7ac0e6
--- /dev/null
+++ b/test/tui-native-regressions.test.mjs
@@ -0,0 +1,42 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { MindCraftInteractiveTui } from '../src/tui-runner.mjs';
+
+function fixture(onExit = () => {}) {
+  const app = {
+    mode: 'mock', liveSessions: new Map(),
+    preflight: { ok: true, checks: { modelRegistry: { count: 0 }, storage: { status: 'pass' } } },
+    async close() {},
+    async configureModel(model) { this.preflight.checks.modelRegistry.count = 1; return model; },
+  };
+  const ui = new MindCraftInteractiveTui({ app, terminal: { columns: 120, rows: 40 }, onExit });
+  ui.tui.requestRender = () => {};
+  ui.tui.stop = () => {};
+  return ui;
+}
+
+test('TUI transcript preserves previous line alignment after repeated output', () => {
+  const ui = fixture();
+  ui.append('ALIGNMENT-SENTINEL');
+  const original = ui.transcript.render(120).find(line => line.includes('ALIGNMENT-SENTINEL'));
+  for (let i = 0; i < 6; i++) ui.append(`new line ${i}`);
+  assert.equal(ui.transcript.render(120).find(line => line.includes('ALIGNMENT-SENTINEL')), original);
+});
+
+test('TUI setup refreshes Model count and removes the obsolete first-run guidance', async () => {
+  const ui = fixture();
+  await ui.submit('setup mock deterministic');
+  const screen = ui.transcript.render(120).join('\n');
+  assert.match(screen, /Model=1/);
+  assert.doesNotMatch(screen, /첫 실행 설정이 필요합니다/);
+  assert.match(screen, /첫 실행 설정이 완료되었습니다/);
+});
+
+test('TUI quit stops the screen and triggers process-exit callback', async () => {
+  let exits = 0;
+  const ui = fixture(() => { exits++; });
+  await ui.submit('quit');
+  await new Promise(resolve => setImmediate(resolve));
+  assert.equal(ui.stopped, true);
+  assert.equal(exits, 1);
+});
